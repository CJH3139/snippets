import:
    net.luckperms.api.LuckPerms
    net.luckperms.api.LuckPermsProvider
    net.luckperms.api.node.Node

#
# Property Expressions
#

offlineplayer property ss prefix:
    get:
        return getPrefix(expr-1)

offlineplayer property ss highest group:
    get:
        return getHighestGroup(expr-1)

expression [the] prefix of group %string%:
    get:
        return getGroupPrefix(expr-1)

# Most of the time useless
player property ss luckperm data:
    get:
        return getLuckPermData(expr-1)

#
# Private API
#

function getLuckPermData(player: player) :: object:
    set {_load} to LuckPermsProvider.get().getUserManager().loadUser({_player}.getUniqueId())
    set {_done} to {_load}.isDone()
    while {_done} is false:
        set {_done} to {_load}.isDone()
    return {_load}.get()

# Same thing as "lp user {user} permission add ..." silly business but its silent so its superior
# Setting `persistance` to false means they only keep the permissions for one sesson, logging out and back in erases changes made here
function addPerms(player: player, permission: string, persistance: boolean = true):
    # Permission building
    LuckPermsProvider.get().getUserManager().getUser({_player}.getUniqueId()).data().add(Node.builder({_permission}).build())

    # Permission saving
    {_persistance} is true
    LuckPermsProvider.get().getUserManager().saveUser(LuckPermsProvider.get().getUserManager().getUser({_player}.getUniqueId()))

# Same thing as "lp user {user} permission remove ..." silly business but its silent so its superior
# Setting `persistance` to false means they only keep the permissions for one sesson, logging out and back in erases changes made here
function removePerms(player: player, permission: string, persistance: boolean = true):
    # Permission removal
    LuckPermsProvider.get().getUserManager().getUser({_player}.getUniqueId()).data().remove(Node.builder({_permission}).build())

    # Permission saving
    {_persistance} is true
    LuckPermsProvider.get().getUserManager().saveUser(LuckPermsProvider.get().getUserManager().getUser({_player}.getUniqueId()))

