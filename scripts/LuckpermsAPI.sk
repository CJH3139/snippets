# <summary>
# Gets a user's highest priority group ID
# </summary>
function getHighestGroup(player: offlineplayer) :: string:
    return LuckPermsProvider.get().getUserManager().getUser({_player}.getUniqueId()).getPrimaryGroup()

# <summary>
# Gets a user's highest priority group prefix but its FORMATTED!!!!
# </summary>
function getPrefix(player: offlineplayer) :: string:
    return formatted LuckPermsProvider.get().getUserManager().loadUser({_player}.getUniqueId()).join().getCachedData().getMetaData().getPrefix()

# <summary>
# Gets a group's prefix by group name
# </summary>
function getGroupPrefix(group: string) :: string:
    set {_g} to LuckPermsProvider.get().getGroupManager().getGroup({_group})
    if {_g} is set:
        return {_g}.getCachedData().getMetaData().getPrefix()
