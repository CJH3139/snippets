local function registerShop(id: item, category: string, buyPrice: integer = 0, sellPrice: integer = 0):
    set {-shop::items::%{_id}%} to Shop struct instance:
        id: {_id}
        category: {_category}
        buyPrice: {_buyPrice}
        sellPrice: {_sellPrice}

local function shopGUI(player: player):
    create a gui with virtual chest inventory with 4 rows named "&0Server Shop":
        make gui slot 11 with brewing stand named "<##db0055>Brewing Shop" with lore "&8Shop Category" and " " and "&fGrab the best brewing" and "&fmaterials from here!" and " " and "&eClick to browse":
            shopTypeGUI(player, "brewing")
        make gui slot 12 with totem of undying named "&eGear Shop" with lore "&8Shop Category" and " " and "&fA shop that contains" and "&fequipment to fight!" and " " and "&eClick to browse":
            shopTypeGUI(player, "gear")
        make gui slot 14 with diamond named "<##007ac7>Ores Shop" with lore "&8Shop Category" and " " and "&fA shop that contains" and "&fores of all types!" and " " and "&eClick to browse":
            shopTypeGUI(player, "ores")
        make gui slot 15 with cooked beef named "<##dd8500>Food Shop" with lore "&8Shop Category" and " " and "&fA shop that contains" and "&ffood!" and " " and "&eClick to browse":
            shopTypeGUI(player, "food")
        make gui slot 21 with sugar cane named "&aFarming Shop" with lore "&8Shop Category" and " " and "&fA shop to sell and buy" and "&ffarming loot!" and " " and "&eClick to browse":
            shopTypeGUI(player, "farming")
        make gui slot 23 with bone named "<##db0055>Mob Loot Shop" with lore "&8Shop Category" and " " and "&fLoot from killing" and "&fmobs can be sold here!" and " " and "&eClick to browse":
            shopTypeGUI(player, "mob")
    open last gui to {_player}

local function shopTypeGUI(player: player, type: string, page: integer = 1):
    set {_items::*} to {-shop::items::*} where [input->category is {_type}]
    set {_hasNext} to whether ({_page}*14+1)th element out of {_items::*} is set
    set {_items::*} to elements from (({_page}-1)*14+1) to ({_page}*14) of {_items::*}
    create a gui with virtual chest inventory with 4 rows named "&0%{_type} in proper case% | Page %{_page}%":
        make gui slots {-edgeSlots::*} with black stained glass pane named "" without tooltip
        if {_page} > 1:
            make gui slot 27 with red dye named "<#ff0000>Previous Page ➡":
                shopTypeGUI({_player}, {_type}, {_page}-1)
        if {_hasNext} is true:
            make gui slot 35 with lime dye named "<#00ff00>Next Page ✔":
                shopTypeGUI({_player}, {_type}, {_page}+1)
        loop {_items::*}:
            set {_data} to loop-value
            set {_lore::1} to ""
            set {_lore::2} to "&c» &7Buy price: &c$%{_data}->buyPrice%"
            if {_data}->sellPrice > 0:
                set {_lore::3} to "&a» &7Sell price: &a$%{_data}->sellPrice%"
            make gui slot {-availableSlots::%loop-iteration%} with {_data}->id with lore {_lore::*}:
                if click action is left mouse button:
                    {_data}->buyPrice > 0
                    buyGUI({_player}, {_data})
                else if click action is right mouse button:
                    {_data}->sellPrice > 0
                    sellGUI({_player}, {_data})
    open last gui to {_player}

local function buyGUI(player: player, data: struct):
    set {_title} to "%{_data}->id%" in proper case
    create a new gui with virtual chest inventory with 6 rows named "&0Buying %{_title}%":
        if metadata "amount" of {_player} is not set:
            set metadata "amount" of {_player} to 1
        make gui slots (integers between 0 and 53) with black stained glass pane named "" without tooltip

        set {_item} to {_data}->id with lore "&7Buy Price: &c$%{_data}->buyPrice * metadata "amount" of {_player}%"
        make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 24 with lime stained glass pane named "&a&lAdd 1":
            if metadata "amount" of {_player} >= 64:
                send "&cYou can't add more, already at maximum!" to {_player}
            else:
                add 1 to metadata "amount" of {_player}
                set {_item} to {_data}->id with lore "&7Buy Price: &c$%{_data}->buyPrice * metadata "amount" of {_player}%"
                make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 25 with 10 lime stained glass pane named "&a&lAdd 10":
            if metadata "amount" of {_player} + 10 > 64:
                send "&cYou can't add 10, would exceed maximum!" to {_player}
            else:
                add 10 to metadata "amount" of {_player}
                set {_item} to {_data}->id with lore "&7Buy Price: &c$%{_data}->buyPrice * metadata "amount" of {_player}%"
                make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 26 with 64 lime stained glass pane named "&a&lSet to 64":
            set metadata "amount" of {_player} to 64
            set {_item} to {_data}->id with lore "&7Buy Price: &c$%{_data}->buyPrice * metadata "amount" of {_player}%"
            make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 18 with red stained glass pane named "&c&lSet to 1":
            set metadata "amount" of {_player} to 1
            set {_item} to {_data}->id with lore "&7Buy Price: &c$%{_data}->buyPrice * metadata "amount" of {_player}%"
            make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 19 with 10 red stained glass pane named "&c&lRemove 10":
            if metadata "amount" of {_player} < 10:
                send "&cYou can't remove 10, amount is too low!" to {_player}
            else:
                remove 10 from metadata "amount" of {_player}
                set {_item} to {_data}->id with lore "&7Buy Price: &c$%{_data}->buyPrice * metadata "amount" of {_player}%"
                make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 20 with red stained glass pane named "&c&lRemove 1":
            if metadata "amount" of {_player} <= 1:
                send "&cYou can't go below 1!" to {_player}
            else:
                remove 1 from metadata "amount" of {_player}
                set {_item} to {_data}->id with lore "&7Buy Price: &c$%{_data}->buyPrice * metadata "amount" of {_player}%"
                make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 41 with red stained glass named "&c&lCancel":
            delete metadata "amount" of {_player}
            shopGUI({_player})

        make gui slot 39 with lime stained glass named "&a&lConfirm":
            if money of {_player} < {_data}->buyPrice * metadata "amount" of {_player}:
                delete metadata "amount" of {_player}
                shopGUI({_player})
                stop
            else:
                remove {_data}->buyPrice * metadata "amount" of {_player} from money of {_player}
                give {_player} metadata "amount" of {_player} of {_data}->id
                delete metadata "amount" of {_player}
                shopGUI({_player})

        run on gui close:
            delete metadata "amount" of {_player}
    open last gui to {_player}

local function sellGUI(player: player, data: struct):
    set {_title} to "%{_data}->id%" in proper case
    create a new gui with virtual chest inventory with 6 rows named "&0Selling %{_title}%":
        if metadata "amount" of {_player} is not set:
            set metadata "amount" of {_player} to 1
        make gui slots (integers between 0 and 53) with black stained glass pane named "" without tooltip
        set {_item} to {_data}->id with lore "&7Sell Price: &a$%{_data}->sellPrice * metadata "amount" of {_player}%"
        make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 24 with lime stained glass pane named "&a&lAdd 1":
            if metadata "amount" of {_player} >= 64:
                send "&cYou can't add more, already at maximum!" to {_player}
            else:
                add 1 to metadata "amount" of {_player}
                set {_item} to {_data}->id with lore "&7Sell Price: &a$%{_data}->sellPrice * metadata "amount" of {_player}%"
                make gui slot 22 with metadata "amount" of {_player} of {_item}
        make gui slot 25 with 10 lime stained glass pane named "&a&lAdd 10":
            if metadata "amount" of {_player} + 10 > 64:
                send "&cYou can't add 10, would exceed maximum!" to {_player}
            else:
                add 10 to metadata "amount" of {_player}
                set {_item} to {_data}->id with lore "&7Sell Price: &a$%{_data}->sellPrice * metadata "amount" of {_player}%"
                make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 26 with 64 lime stained glass pane named "&a&lSet to 64":
            set metadata "amount" of {_player} to 64
            set {_item} to {_data}->id with lore "&7Sell Price: &a$%{_data}->sellPrice * metadata "amount" of {_player}%"
            make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 18 with red stained glass pane named "&c&lSet to 1":
            set metadata "amount" of {_player} to 1
            set {_item} to {_data}->id with lore "&7Sell Price: &a$%{_data}->sellPrice * metadata "amount" of {_player}%"
            make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 19 with 10 red stained glass pane named "&c&lRemove 10":
            if metadata "amount" of {_player} < 10:
                send "&cYou can't remove 10, amount is too low!" to {_player}
            else:
                remove 10 from metadata "amount" of {_player}
                set {_item} to {_data}->id with lore "&7Sell Price: &a$%{_data}->sellPrice * metadata "amount" of {_player}%"
                make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 20 with red stained glass pane named "&c&lRemove 1":
            if metadata "amount" of {_player} <= 1:
                send "&cYou can't go below 1!" to {_player}
            else:
                remove 1 from metadata "amount" of {_player}
                set {_item} to {_data}->id with lore "&7Sell Price: &a$%{_data}->sellPrice * metadata "amount" of {_player}%"
                make gui slot 22 with metadata "amount" of {_player} of {_item}

        make gui slot 41 with red stained glass named "&c&lCancel":
            delete metadata "amount" of {_player}
            shopGUI({_player})

        make gui slot 39 with lime stained glass named "&a&lConfirm":
            set {_playerAmount} to amount of {_data}->id in {_player}'s inventory
            if {_playerAmount} < metadata "amount" of {_player}:
                send "&cYou don't have enough of this item to sell!" to {_player}
                delete metadata "amount" of {_player}
                shopGUI({_player})
                stop
            else:
                remove metadata "amount" of {_player} of {_data}->id from {_player}'s inventory
                add {_data}->sellPrice * metadata "amount" of {_player} to money of {_player}
                delete metadata "amount" of {_player}
                shopGUI({_player})

        run on gui close:
            delete metadata "amount" of {_player}

command /shop:
    trigger:
        shopGUI(player)
