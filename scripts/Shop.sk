    registerShop(cooked salmon, "farming", 90, 18)
    registerShop(salmon, "farming", 90, 18)
    registerShop(cooked cod, "farming", 90, 18)
    registerShop(cod, "farming", 90, 18)
    registerShop(pufferfish, "farming", 120, 17)

    registerShop(feather, "mob", 0, 6)
