###
# Shop Skript
#
# SMP/Lifesteal styled shop with 100+ configurable items across 6 categories,
# with buy and sell GUIs and per-item pricing.
#
# Requires:
# - Skript
# - SkBee
# - skript-gui
# - skript-reflect
# - oopsk
#
# author: CJH (https://discord.gg/5Dr4XR5Znj)
# version: 1.0
# license: Noncommercial (Do NOT resell or distribute this without permission)
###

player property money:
    get:
        return {playerData::%expr-1%::money} ? 0
    set:
        set {playerData::%expr-1%::money} to change value
    add:
        add change value to {playerData::%expr-1%::money}
    remove:
        subtract change value from {playerData::%expr-1%::money}


struct Shop:
    id: item
    category: string
    buyPrice: integer
    sellPrice: integer

on script load:
    delete {-shop::items::*}
    set {-availableSlots::*} to (integers between 10 and 16) and (integers between 19 and 25)
    set {-edgeSlots::*} to (integers between 0 to 9), 17, 18 and (integers between 26 and 35)

    registerShop(coal, "ores", 50, 13)
    registerShop(copper ingot, "ores", 70, 3)
    registerShop(iron ingot, "ores", 102, 37)
    registerShop(gold ingot, "ores", 140, 37)
    registerShop(emerald, "ores", 100, 2)
    registerShop(lapis lazuli, "ores", 50, 13)
    registerShop(diamond, "ores", 450, 100)
    registerShop(coal block, "ores", 180, 60)
    registerShop(copper block, "ores", 110, 7)
    registerShop(iron block, "ores", 570, 150)
    registerShop(gold block, "ores", 700, 200)
    registerShop(emerald block, "ores", 550, 20)
    registerShop(lapis block, "ores", 230, 65)
    registerShop(diamond block, "ores", 2500, 850)
    registerShop(netherite ingot, "ores", 1200, 300)
    registerShop(redstone, "ores", 70, 6)
    registerShop(amethyst shard, "ores", 90, 10)
    registerShop(raw gold, "ores", 90, 30)
    registerShop(raw iron, "ores", 90, 17)
    registerShop(raw copper, "ores", 70, 2)
    registerShop(netherite block, "ores", 6000, 2000)
    registerShop(redstone block, "ores", 190, 30)
    registerShop(amethyst block, "ores", 30, 4)
    registerShop(gold ore, "ores", 95, 30)
    registerShop(iron ore, "ores", 110, 17)
