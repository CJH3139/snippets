    registerShop(shield, "gear", 250)
    registerShop(tnt, "gear", 150)

    registerShop(cooked porkchop, "food", 25)
    registerShop(cooked mutton, "food", 22)
    registerShop(cooked chicken, "food", 20)
    registerShop(golden carrot, "food", 150)
